PORT=5000
NODE_ENV=development

# MongoDB — local or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/freshbasket

# Comma-separated list of allowed front-end origins (CORS)
CLIENT_URL=http://localhost:5173

# Razorpay — Dashboard → Settings → API Keys (use Test Mode keys while developing)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard → Settings → Webhooks → your own secret (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_string
